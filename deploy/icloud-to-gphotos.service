[Unit]
Description=Migrate iCloud Photos to Google Photos
Documentation=file:///opt/icloud-to-gphotos/docs/DEPLOY_LINUX.md
# Pointless to start without a network; does not fail the unit if offline.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot

# Adjust if you installed elsewhere or run as a different user.
User=i2g
Group=i2g
WorkingDirectory=/opt/icloud-to-gphotos
EnvironmentFile=/opt/icloud-to-gphotos/.env

# Call the venv's console script directly rather than going through `uv run`.
# uv insists on writing a lock file into its cache under $HOME, which the
# hardening below makes read-only, so `uv run` fails before the pipeline starts:
#   error: Could not acquire lock ... Read-only file system (os error 30)
# The script has an absolute shebang into .venv/bin/python, so it needs no
# activation, no cache and no writable $HOME. `uv sync` at install time is what
# keeps this venv current.
ExecStart=/opt/icloud-to-gphotos/.venv/bin/i2g run

# The project tree is read-only here, so bytecode writes would fail silently
# anyway; skip the pointless attempts. Unbuffered output keeps `journalctl -f`
# live during a long pass instead of arriving in blocks.
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

# A full first pass over a large library can take many hours; only give up if it
# has genuinely wedged.
TimeoutStartSec=20h

# Never restart automatically: a failed run has already reported itself, and
# retrying blindly against Apple's API is how you get rate limited. The timer
# will try again tomorrow.
Restart=no

# The pipeline is disk- and network-bound. Deprioritise it so it does not
# starve anything else on a small VM.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

StandardOutput=journal
StandardError=journal
SyslogIdentifier=icloud-to-gphotos

# --- Hardening -------------------------------------------------------------
# The service needs to read its checkout, write state, and reach the network.
# Everything else is off.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

# State, staging, logs and reports live here. Must match I2G_STATE_DIR and
# I2G_STAGING_DIR in .env.
ReadWritePaths=/var/lib/icloud-to-gphotos

[Install]
WantedBy=multi-user.target
