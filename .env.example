# Copy to .env and fill in. Every setting is optional except I2G_ICLOUD_USERNAME.
# Values shown are the defaults.

# ---------------------------------------------------------------------------
# iCloud
# ---------------------------------------------------------------------------
I2G_ICLOUD_USERNAME=you@example.com

# Only used by `i2g login`. You can leave this unset and be prompted instead;
# once a trusted session exists the password is never read again.
#I2G_ICLOUD_PASSWORD=

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# Where cookies, the ledger, logs and reports live.
#   Linux default:   $XDG_STATE_HOME/icloud-to-gphotos  (~/.local/state/...)
#   Windows default: %LOCALAPPDATA%\icloud-to-gphotos
#I2G_STATE_DIR=/var/lib/icloud-to-gphotos

# Scratch space for downloads. Defaults to <state_dir>/staging.
# Point this at your largest disk.
#I2G_STAGING_DIR=/var/lib/icloud-to-gphotos/staging

# Auto-discovered on PATH and ./bin; set only if you need a specific one.
#I2G_GOTOHP_BINARY=/opt/gotohp/gotohp-cli_amd64
#I2G_GOTOHP_CONFIG=/etc/gotohp/gotohp.config
#I2G_EXIFTOOL_BINARY=/usr/bin/exiftool

# ---------------------------------------------------------------------------
# Batching — bounds peak disk usage so library size does not matter
# ---------------------------------------------------------------------------
# 20 GiB. Shrunk automatically if the disk cannot spare that much.
#I2G_BATCH_MAX_BYTES=21474836480
#I2G_BATCH_MAX_ITEMS=500

# Refuse to start a batch unless this much disk stays free. 5 GiB.
#I2G_DISK_HEADROOM_BYTES=5368709120

# Unset means "keep going until the library is drained".
#I2G_MAX_BATCHES_PER_RUN=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# For photos edited in iCloud: both | edited | original
#   both     upload the untouched original AND the rendered edit (two items)
#   edited   upload only the rendered edit
#   original upload only the untouched original; your crops/filters are lost
#I2G_EDITED_POLICY=both

#I2G_INCLUDE_LIVE_PHOTO_VIDEO=true
#I2G_PAIR_LIVE_PHOTOS=true

# Pair Live Photos by filename stem instead of Apple content identifier.
# Only enable if pairing is failing; risks mismatching same-named files.
#I2G_IGNORE_APPLE_METADATA=false

# Also upload resOriginalAlt (the JPEG stored beside a ProRAW DNG).
# Creates a second Google Photos item per ProRAW shot.
#I2G_INCLUDE_ALTERNATIVE_ORIGINAL=false

# Use exiftool to write capture date / GPS into files that lack them.
# Strongly recommended: without it, HEIC and videos missing embedded dates get
# filed by upload time in Google Photos.
#I2G_BACKFILL_METADATA=true

# ---------------------------------------------------------------------------
# Deletion — the only irreversible step
# ---------------------------------------------------------------------------
# Master switch. Set false to run download+upload only and just report what
# would be deleted.
#I2G_DELETE_FROM_ICLOUD=true

# Never delete anything captured within this many days, so items still syncing
# from a phone are safe. iCloud deletions land in Recently Deleted for 30 days.
#I2G_DELETE_GRACE_DAYS=7

# ---------------------------------------------------------------------------
# Concurrency
# ---------------------------------------------------------------------------
#I2G_DOWNLOAD_WORKERS=4
#I2G_UPLOAD_THREADS=3

# ---------------------------------------------------------------------------
# Notifications (ntfy.sh)
# ---------------------------------------------------------------------------
# Pick an unguessable topic name; anyone who knows it can read your notices.
#I2G_NTFY_TOPIC=icloud-sync-3f9a2c
#I2G_NTFY_SERVER=https://ntfy.sh
#I2G_NTFY_TOKEN=
#I2G_NOTIFY_ON_SUCCESS=true

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
#I2G_LOG_LEVEL=INFO
#I2G_LOG_RETENTION=30
